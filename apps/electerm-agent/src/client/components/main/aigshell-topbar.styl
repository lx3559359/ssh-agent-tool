.aigshell-topbar
  position absolute
  left 0
  right 0
  top 0
  height 44px
  z-index 400
  display flex
  align-items center
  justify-content space-between
  padding 0 14px
  background-color #306290
  background-image var(--sp-topbar-background)
  border-bottom 1px solid rgba(255, 255, 255, .2)
  box-shadow 0 8px 22px rgba(38, 63, 99, .18)
  color rgba(255, 255, 255, .9)
  -webkit-app-region drag

.aigshell-topbar-brand
  display flex
  align-items center
  gap 10px
  min-width 0
  height 100%
  font-size 13px
  img
    width 24px
    height 24px
    border-radius 5px
    flex none

.aigshell-topbar-name
  font-weight 650
  color rgba(255, 255, 255, .96)
  white-space nowrap

.aigshell-topbar-version
  height 20px
  line-height 20px
  padding 0 7px
  border-radius 999px
  color rgba(255, 255, 255, .94)
  background rgba(255, 255, 255, .14)
  border 1px solid rgba(255, 255, 255, .2)
  font-size 12px
  font-weight 600
  white-space nowrap
  flex none

.aigshell-topbar-separator
  width 1px
  height 18px
  background rgba(255, 255, 255, .22)
  flex none

.aigshell-topbar-current
  max-width 260px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  color rgba(255, 255, 255, .82)
  font-weight 500

.aigshell-topbar-dot
  width 7px
  height 7px
  border-radius 50%
  background rgba(255, 255, 255, .44)
  flex none
  &.online
    background var(--success)

.aigshell-topbar-status
  display inline-flex
  align-items center
  flex none

.aigshell-topbar-status-text
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.aigshell-topbar-actions
  display flex
  align-items center
  gap 6px
  min-width 0
  height 100%
  padding-right 138px
  background transparent
  -webkit-app-region no-drag

.aigshell-topbar-action-wrap
  display inline-flex
  align-items center

.aigshell-topbar-action-group-boundary
  border-left 1px solid rgba(255, 255, 255, .22)
  padding-left 6px
  margin-left 2px

.aigshell-topbar-action
  height 30px
  padding 0 10px
  color rgba(255, 255, 255, .9)
  background rgba(255, 255, 255, .08)
  border 1px solid rgba(255, 255, 255, .18)
  border-radius var(--sp-radius-control)
  box-shadow none
  font-size 13px
  font-weight 500
  &:hover
    color #fff !important
    background rgba(255, 255, 255, .16) !important
    border-color rgba(255, 255, 255, .34) !important
  &:active
    color #fff !important
    background rgba(255, 255, 255, .22) !important
    box-shadow inset 0 1px 3px rgba(28, 41, 80, .32)
  &:disabled
    color rgba(255, 255, 255, .42) !important
    background rgba(255, 255, 255, .04) !important
    border-color rgba(255, 255, 255, .1) !important
    box-shadow none

.aigshell-topbar-action-primary
  border-color rgba(255, 255, 255, .38)
  color #fff
  background rgba(255, 255, 255, .18)
  box-shadow 0 4px 12px rgba(22, 31, 67, .16)
  &:hover
    border-color rgba(255, 255, 255, .5) !important
    color #fff !important
    background rgba(255, 255, 255, .24) !important

.aigshell-topbar
  .window-controls
    top 0
    right 0
    height 44px
    background transparent
    border-radius 0
    display flex
    align-items stretch
  .window-control-box
    width 46px
    height 44px
    padding 0
    border 0
    border-radius 0
    background transparent
    cursor pointer
    display flex
    align-items center
    justify-content center
    color rgba(255, 255, 255, .9)
    &:hover
      color #fff
      background rgba(255, 255, 255, .14)
  .window-control-close:hover
    color var(--primary-contrast)
    background var(--error)

.system-ui .aigshell-topbar-actions
  padding-right 0

@media (max-width: 1760px)
  .aigshell-topbar-actions
    gap 2px
  .aigshell-topbar-action
    width 30px
    padding 0
  .aigshell-topbar-action-label
    display none

@media (max-width: 900px)
  .aigshell-topbar
    padding-left 8px
  .aigshell-topbar-current
  .aigshell-topbar-separator
  .aigshell-topbar-dot
    display none
  .aigshell-topbar-brand
    gap 6px

@media (max-width: 720px)
  .aigshell-topbar-actions
    flex 1 1 auto
    gap 0
    min-width 0
    overflow-x auto
    overflow-y hidden
    overscroll-behavior-x contain
    scrollbar-width none
    &::-webkit-scrollbar
      height 0
  .not-system-ui .aigshell-topbar-actions
    margin-right 138px
    padding-right 0
  .system-ui .aigshell-topbar-actions
    margin-right 0
    padding-right 0
  .aigshell-topbar-action-wrap
    flex 0 0 30px
    min-width 0
    &:last-child
      margin-right 1px
  .aigshell-topbar-action
    width 100%
    min-width 0

@media (max-width: 480px)
  .aigshell-topbar
    padding 0 6px
  .aigshell-topbar-brand
    flex 0 0 24px
    gap 0
  .aigshell-topbar-name
  .aigshell-topbar-version
    display none
