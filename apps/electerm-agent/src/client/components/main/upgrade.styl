.upgrade-panel
  position fixed
  right 10px
  bottom 10px
  z-index 888
  background-image var(--sp-overlay-background)
  border-radius var(--sp-radius-overlay)
  border 1px solid var(--sp-border-strong)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)
  padding 0
  width 440px
.upgrade-panel-hide
  display none
.close-upgrade-panel
  &:hover
    color var(--success)
.upgrade-panel-title
.upgrade-panel-body
  padding 10px 15px
.upgrade-panel-title
  border-bottom 1px solid var(--main-darker)
.markdown-wrap
  max-height 20vh
  overflow-y auto
  background var(--sp-flat-background)
  box-shadow none
