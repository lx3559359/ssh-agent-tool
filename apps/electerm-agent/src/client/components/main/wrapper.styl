
.error-wrapper
  background-color var(--sp-page)
  background-image var(--sp-page-background)
  height 100%
  width 100%
  box-sizing border-box
  position fixed
  overflow-y scroll
  color var(--text)

.sp-safe-error-diagnostic
  max-width 720px
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)

#container
  .xterm
    padding 10px
  .session-batch-active
    .xterm-screen
      &::before
        font-size 30vmin
        font-weight bold
        color var(--text)
        display flex
        justify-content center
        align-items center
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        z-index -1
