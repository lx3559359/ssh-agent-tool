.update-center-modal
  color var(--text)
  .custom-modal-content
    background-image var(--sp-overlay-background)
    box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)

.update-center-summary
  margin 0
  display grid
  grid-template-columns repeat(auto-fit, minmax(150px, 1fr))
  gap 12px 20px
  padding 14px 16px
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  background-image var(--sp-card-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)

  div
    display grid
    gap 4px

  dt
    color var(--text-light)
    font-size 12px

  dd
    margin 0
    color var(--sp-text)
    font-weight 650
    overflow-wrap anywhere

.update-center-message
  margin 14px 0 0

.update-center-section
  padding-top 16px

.update-center-section-title
  margin-top 0
  margin-bottom 8px
  color var(--sp-text)
  font-size 14px
  font-weight 600

.update-center-actions
  display flex
  align-items center
  flex-wrap wrap
  gap 8px
  padding-top 14px

.update-center-source
  display grid
  grid-template-columns auto minmax(210px, 320px) 1fr
  align-items center
  gap 12px
  margin 16px 0
  padding 10px 12px
  border-radius var(--sp-radius-control)
  background-image var(--sp-control-background)
  box-shadow var(--sp-shadow-control)

@media (max-width: 560px)
  .update-center-source
    grid-template-columns 1fr

.update-center-changelog
  max-height min(38vh, 360px)
  padding 10px
  overflow auto
  background var(--sp-flat-background)
  box-shadow none
