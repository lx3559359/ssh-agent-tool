.sftp-wrap
  display flex
  flex-direction row
  &:has(> .sftp-transfer-progress-dock)
    .sftp-section
      height calc(100% - 64px) !important
.sftp-transfer-progress-dock
  position fixed
  z-index 20
  left 10px
  right 10px
  bottom 8px
  max-width calc(100vw - 20px)
  min-height 50px
  color var(--sp-text)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-overlay-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-lg)
  overflow hidden
.sftp-transfer-dock-summary
  display grid
  grid-template-columns auto minmax(80px, 1fr) auto auto
  align-items center
  gap 10px
  min-height 40px
  padding 5px 10px
.sftp-transfer-dock-leading
  display flex
  align-items center
  gap 7px
  min-width 0
.sftp-transfer-dock-direction
  padding 2px 7px
  color var(--sp-primary)
  background var(--sp-primary-soft)
  border-radius var(--sp-radius-control)
  font-weight 650
  white-space nowrap
.sftp-transfer-dock-count
  font-weight 650
  white-space nowrap
.sftp-transfer-dock-current
  min-width 0
  color var(--sp-text-muted)
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.sftp-transfer-dock-outcome
  min-width 0
  color var(--sp-text)
  font-weight 650
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.sftp-transfer-dock-metrics
  color var(--sp-text-muted)
  font-variant-numeric tabular-nums
  white-space nowrap
.sftp-transfer-dock-percent
  color var(--sp-primary)
  font-weight 650
.sftp-transfer-dock-toggle
  padding 3px 8px
  color var(--sp-text)
  background var(--sp-control-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-control)
  cursor pointer
  &:hover
    border-color var(--sp-primary)
  &:focus-visible
    outline 2px solid var(--sp-primary)
    outline-offset 2px
.sftp-transfer-dock-dismiss
  display inline-flex
  width 32px
  height 32px
  padding 0
  align-items center
  justify-content center
  color var(--sp-text-muted)
  background transparent
  border 1px solid transparent
  border-radius var(--sp-radius-control)
  cursor pointer
  &:hover
    color var(--sp-text)
    background var(--sp-control-background)
    border-color var(--sp-border)
  &:focus-visible
    outline 2px solid var(--sp-primary)
    outline-offset 2px
.sftp-transfer-dock-progress
  position relative
  height 8px
  background var(--sp-surface-soft)
  overflow hidden
  > span
    display block
    height 100%
    min-width 2px
    background var(--sp-primary)
    transition width .1s linear
.sftp-transfer-dock-progress-indeterminate
  > span
    width 35%
    animation sftp-transfer-progress-indeterminate 1.1s ease-in-out infinite
.sftp-transfer-progress-dock-running,
.sftp-transfer-progress-dock-resuming,
.sftp-transfer-progress-dock-pausing,
.sftp-transfer-progress-dock-queued
  border-color var(--sp-primary)
.sftp-transfer-progress-dock-paused,
.sftp-transfer-progress-dock-interrupted
  .sftp-transfer-dock-progress > span
    background var(--warning)
.sftp-transfer-progress-dock-failed
  border-color var(--error)
  .sftp-transfer-dock-direction
    color var(--error)
    background unquote('color-mix(in srgb, var(--error) 14%, transparent)')
  .sftp-transfer-dock-progress > span
    background var(--error)
.sftp-transfer-progress-dock-partial
  border-color var(--warning)
  .sftp-transfer-dock-direction
    color var(--warning)
    background unquote('color-mix(in srgb, var(--warning) 14%, transparent)')
  .sftp-transfer-dock-progress > span
    background var(--warning)
.sftp-transfer-progress-dock-completed
  border-color var(--success)
  .sftp-transfer-dock-direction
    color var(--success)
    background unquote('color-mix(in srgb, var(--success) 14%, transparent)')
  .sftp-transfer-dock-progress > span
    background var(--success)
.sftp-transfer-dock-details
  max-height 220px
  padding 6px 8px 2px
  overflow auto
  border-top 1px solid var(--sp-border)
  .sftp-transport-compact
    margin-bottom 5px
    background var(--sp-flat-background)
.sftp-transfer-dock-terminal-item
  display grid
  grid-template-columns minmax(140px, 1fr) minmax(180px, 1.4fr)
  gap 12px
  align-items center
  min-height 38px
  margin-bottom 5px
  padding 5px 8px
  background var(--sp-flat-background)
  border-radius var(--sp-radius-control)
.sftp-transfer-dock-terminal-path,
.sftp-transfer-dock-terminal-status
  min-width 0
  overflow-wrap anywhere
.sftp-transfer-dock-terminal-status
  color var(--sp-text-muted)
.sftp-transfer-dock-terminal-status.is-skipped
  color var(--warning)
.sftp-transfer-dock-terminal-status.is-failed,
.sftp-transfer-dock-terminal-status.is-exception
  color var(--error)
.sftp-fast-delete-confirmation
  display grid
  gap 10px
.sftp-delete-risk-badge
  width max-content
  padding 3px 8px
  color var(--sp-danger)
  background unquote('color-mix(in srgb, var(--sp-danger) 12%, transparent)')
  border 1px solid var(--sp-danger)
  border-radius var(--sp-radius-control)
  font-weight 700
.sftp-delete-targets
  display block
  max-height 96px
  padding 8px 10px
  color var(--sp-text)
  background var(--sp-flat-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-control)
  overflow auto
  overflow-wrap anywhere
  white-space normal
.sftp-safe-delete-dialog
  display grid
  gap 10px
.sftp-safe-delete-state
  padding 9px 10px
  color var(--sp-text)
  background var(--sp-primary-soft)
  border-left 3px solid var(--sp-primary)
  border-radius var(--sp-radius-control)
.sftp-safe-delete-dialog.is-ready .sftp-safe-delete-state
  color var(--success)
  border-left-color var(--success)
.sftp-safe-delete-dialog.is-failed .sftp-safe-delete-state
  color var(--error)
  border-left-color var(--error)
.sftp-safe-delete-progress
  position relative
  height 8px
  margin 12px 0 6px
  overflow hidden
  background var(--sp-control-background)
  border-radius 999px
  > span
    display block
    height 100%
    background var(--sp-primary)
    transition width 100ms linear
  &.is-indeterminate > span
    width 35%
    animation sftp-transfer-progress-indeterminate 1.1s ease-in-out infinite
.sftp-safe-delete-bytes
  min-height 20px
  color var(--sp-text-muted)
  font-variant-numeric tabular-nums

@keyframes sftp-transfer-progress-indeterminate
  from
    transform translateX(-110%)
  to
    transform translateX(310%)

@media (max-width: 760px)
  .sftp-transfer-dock-summary
    grid-template-columns auto minmax(60px, 1fr) auto auto
  .sftp-transfer-dock-metrics-detail
    display none
  .sftp-transfer-dock-terminal-item
    grid-template-columns 1fr
    gap 3px
.sftp-section
  flex 1
  box-sizing border-box
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-panel)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-md)
.sftp-title-wrap
  position relative
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  border-bottom 1px solid var(--sp-border)
.sftp-panel-title-remote
  display flex
  align-items flex-start
  gap 8px
  min-width 0
  border-bottom 0
.sftp-panel-heading
  display flex
  flex 1
  flex-direction column
  gap 2px
  min-width 80px
.sftp-panel-location
  display block
  min-width 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.sftp-panel-identities
  display flex
  flex-wrap wrap
  align-items center
  gap 3px 8px
  min-width 0
  color var(--sp-text-muted)
  font-size 12px
  line-height 1.35
.sftp-login-identity,
.sftp-file-identity
  display inline-flex
  align-items center
  gap 4px
.sftp-file-identity.is-pty-root
  color var(--sp-text)
  font-weight 600
  background var(--sp-primary-soft)
  border 1px solid var(--sp-primary)
  border-radius var(--sp-radius-control)
  padding 1px 5px
.sftp-file-identity-marker
  font-size 9px
  font-weight 700
  letter-spacing .04em
.sftp-file-operation-status
  flex-basis 100%
  color var(--sp-text-muted)
.sftp-file-operation-status.is-busy
  color var(--warning)
.sftp-file-operation-status.is-unavailable
  color var(--error)
.sftp-file-operation-status.is-uncertain
  color var(--error)
  font-weight 600
.sftp-safety-actions
  display flex
  align-items center
  gap 2px
  flex none
  .ant-btn
    height 26px
    padding 0 7px
    border-radius var(--sp-radius-control)
    box-shadow var(--sp-shadow-sm)
.sftp-safety-summary
  line-height 1.7
  padding 10px 12px
  margin-bottom 12px
  border 1px solid var(--primary)
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
.sftp-safety-confirmation
  line-height 1.65
.sftp-text-change-confirmation
  margin-top 12px
  border 1px solid var(--main-darker)
  border-radius var(--sp-radius-card)
  overflow hidden
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-lg)
.sftp-text-change-path
  padding 7px 10px
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  color var(--text)
  font-family monospace
  border-bottom 1px solid var(--main-darker)
.sftp-text-change-summary,
.sftp-text-change-note
  padding 7px 10px
  color var(--text-light)
  font-size 12px
.sftp-text-change-preview
  max-height 260px
  margin 0
  padding 6px 0
  overflow auto
  color var(--text)
  background var(--sp-flat-background)
  box-shadow none
.sftp-text-change-line
  display flex
  min-width max-content
  line-height 20px
  > span
    width 24px
    flex none
    text-align center
    user-select none
  > code
    padding-right 12px
    white-space pre
  &.is-add
    background rgba(44, 160, 85, .16)
    > span
      color var(--success)
  &.is-remove
    background rgba(220, 53, 69, .14)
    > span
      color var(--error)
.sftp-safety-records
  max-height 480px
  overflow-y auto
  padding-right 4px
.sftp-safety-record
  display flex
  align-items center
  gap 12px
  padding 12px
  margin-bottom 8px
  border 1px solid var(--main-darker)
  border-radius var(--sp-radius-small)
  background var(--sp-flat-background)
  box-shadow none
.sftp-safety-record-main
  flex 1
  min-width 0
.sftp-safety-record-title
  display flex
  align-items center
  min-width 0
  font-weight 600
  > span:last-child
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
.sftp-safety-record-meta,
.sftp-safety-record-path
  margin-top 5px
  color var(--text-light)
  font-size 12px
.sftp-safety-record-path
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
.sftp-item
  position relative
  z-index 3
  padding 0
  line-height 26px
  height 32px
  user-select none
  margin-bottom 4px
  border-bottom 1px solid var(--sp-border)
  background var(--sp-flat-background)
  box-shadow none
  &:nth-child(even)
    .sftp-file-prop
      background var(--sp-surface)
  &:hover
    background var(--sp-surface-soft)
    .sftp-file-prop
      background-color var(--sp-surface-soft)
      color var(--sp-text)
  &.selected
    background var(--sp-primary-soft)
    .sftp-file-prop
      background-color var(--sp-primary-soft)
      color var(--sp-text)

.sftp-item:focus-visible
  outline 2px solid var(--sp-primary)
  outline-offset -2px
  .sftp-file-prop
    background var(--sp-info-soft)
    color var(--sp-text)
.sftp-history
  position absolute
  left 0
  top 100%
  right 0
  z-index 30
  box-shadow none
  border none
  height 0
  background-color var(--sp-surface-elevated)
  background-image var(--sp-overlay-background)
  overflow hidden
  border-radius var(--sp-radius-overlay)
  &.focused
    height auto
    border 1px solid var(--main-darker)
    box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-lg)

.sftp-history-item
  padding 5px 10px
  cursor pointer
  border-bottom 1px solid var(--main-darker)
  &:hover
    background var(--primary)
    color var(--primary-contrast)

.sftp-item-title
  width 100%
.sftp-item-title
    width 75%
.sftp-item-size
  width 24%
.sftp-status-success
  color var(--success)
.sftp-status-exception
  color var(--error)
.sftp-status-active
  color var(--primary)

.virtual-file
  .sftp-item
    position absolute
    left 0
    right 10px
    bottom 0
    top 0
    z-index 1
    height 100%
    padding 0
    margin 0

.file-icon
  position absolute
  left 10px
  top 10px
  font-size 50px
.file-props-div
  display flex
  width 100%
.file-props
  margin-left 70px

.sftp-sort-btn
  &.active
    font-weight bold
    color var(--text-light)

//list table
.sftp-file-prop
  flex 0 0 auto
  height 32px
  line-height 30px
  padding 0 5px
  background var(--sp-flat-background)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  pointer-events none
  cursor default
  color var(--text)

.file-bg
  position absolute
  left 0
  top 0
  right 0
  height 32px
  z-index 3

.sftp-header-item
  height 28px
  line-height 25px
  padding 0 5px
  background var(--sp-flat-background)
  overflow hidden
  white-space nowrap
  text-overflow ellipsis
  color var(--sp-text-muted)
  font-weight 650

.sftp-file-table-header
  height 30px
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  border-bottom 1px solid var(--sp-border)
.sftp-table
  z-index 2
  &:hover
    ::-webkit-scrollbar
      width 12px
.sftp-item
  &.sftp-dragover
    .sftp-file-prop
      background var(--primary) !important
      color var(--text) !important
  &.sftp-dragover-multi
    &:after
    &:before
      position absolute
      left 2px
      top 2px
      width 100%
      height 100%
      background var(--main-lighter)
      content ''
      z-index -1
    &:after
      left 4px
      top 4px
.icon-holder
  width 1em
  display inline-block
.symbolic-link-icon
  margin-right 2px

//sftp
.sftp-panel
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)

.file-list
  ::-webkit-scrollbar-thumb
    background-color var(--primary) !important

.pager-wrap
  z-index 4
  position relative

.sftp-has-pager
  .sftp-table-content
    padding-bottom 42px
  .pager-wrap
    position absolute
    bottom 0
    left 0
    width 100%
    background var(--sp-flat-background)
    height 40px
    border-top 1px solid var(--main-darker)

.file-header-context-menu
  position fixed
  z-index 999

.keyword-filter-icon
  &:hover
  &.active
    color var(--success)
