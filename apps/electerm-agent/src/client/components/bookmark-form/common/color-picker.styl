.color-picker-unit
  display inline-block
  padding 5px
  margin-right 5px
  margin-bottom 5px
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-control)
  cursor pointer
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  box-shadow var(--sp-shadow-control)
  width 92px
.color-picker-box
  width 420px

.color-picker-defaults
  width 200px
.color-picker-choose
  width 18px
  height 18px
  cursor pointer
