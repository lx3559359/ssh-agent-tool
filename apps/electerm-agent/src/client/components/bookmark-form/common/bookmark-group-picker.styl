.bookmark-group-picker
  width 100%

.bookmark-group-picker-select
  min-width 0
  flex 1
  .ant-select-selector
    background-color var(--sp-surface) !important
    background-image var(--sp-control-background) !important
    border-color var(--sp-border) !important

.bookmark-group-picker label
  display block
  margin 12px 0 6px
  color var(--sp-text-muted)
