.operations-toolkit-loading
  position absolute
  left 50%
  top 50%
  z-index 90
  transform translate(-50%, -50%)
  color var(--text-dark)

.operations-toolkit-workspace
  box-sizing border-box
  position absolute
  right var(--operations-right-offset, 10px)
  bottom 44px
  z-index 89
  height 680px
  max-height calc(100vh - 88px)
  min-height 360px
  display flex
  flex-direction column
  overflow hidden
  color var(--text)
  background var(--main)
  border 1px solid var(--main-darker)
  border-radius 10px
  box-shadow 0 -12px 28px rgba(0, 0, 0, .2)

.operations-workspace-head
  min-height 48px
  padding 0 14px
  display flex
  align-items center
  justify-content space-between
  border-bottom 1px solid var(--main-darker)
  background var(--main-light)
  > div
    min-width 0
    display flex
    align-items baseline
    gap 10px
    strong
      font-size 15px
    span
      font-size 12px
      color var(--text-dark)

.operations-workspace-tabs
  margin 10px 14px 0
  flex 0 0 auto

.operations-workspace-body
  position relative
  flex 1
  min-height 0
  margin-top 10px
  overflow hidden

.operations-discovery-spin
  position absolute
  top 48px
  right 26px
  z-index 2

.operations-diagnostic
  height 100%
  min-height 0
  display grid
  grid-template-columns minmax(230px, 29%) minmax(0, 1fr)
  border-top 1px solid var(--main-darker)

.operations-catalog
  min-width 0
  padding 12px
  display flex
  flex-direction column
  gap 10px
  overflow hidden
  border-right 1px solid var(--main-darker)
  background var(--main-light)

.operations-categories
  display flex
  gap 5px
  overflow-x auto
  scrollbar-width thin
  button
    flex 0 0 auto
    padding 4px 8px
    color var(--text-dark)
    background transparent
    border 0
    border-radius 4px
    cursor pointer
    &.active
      color var(--primary)
      background var(--main)

.operations-tool-list
  flex 1
  min-height 0
  display flex
  flex-direction column
  gap 7px
  overflow-y auto
  > button
    min-width 0
    padding 9px 10px
    display flex
    flex-direction column
    gap 4px
    text-align left
    color var(--text)
    background var(--main)
    border 1px solid var(--main-darker)
    border-radius 6px
    cursor pointer
    &:hover
      border-color var(--primary)
    &.active
      border-color var(--primary)
      box-shadow inset 3px 0 0 var(--primary)
    strong
      font-size 13px
    span
      overflow hidden
      color var(--text-dark)
      font-size 12px
      line-height 1.5
      display -webkit-box
      -webkit-line-clamp 2
      -webkit-box-orient vertical
    small
      color var(--text-dark)

.operations-tool-detail
  min-width 0
  padding 16px
  overflow-y auto

.operations-tool-title
  display flex
  justify-content space-between
  align-items flex-start
  gap 12px
  h3
    margin 0
    font-size 17px
  p
    margin 5px 0 0
    color var(--text-dark)
    line-height 1.5

.operations-connection-status
  min-height 36px
  margin 14px 0
  padding 6px 10px
  display flex
  align-items center
  gap 7px
  color var(--text-dark)
  background var(--main-light)
  border 1px solid var(--main-darker)
  border-radius 6px
  > span
    width 7px
    height 7px
    border-radius 50%
    background var(--text-dark)
    &.connected
      background #22b573
  button
    margin-left auto

.operations-discovery-error,
.operations-task-error
  margin 8px 0
  padding 8px 10px
  color var(--error)
  background var(--main-light)
  border 1px solid var(--error)
  border-radius 6px

.operations-parameter-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 12px

.operations-parameter-field
  min-width 0
  display flex
  flex-direction column
  gap 5px
  > span
    font-size 12px
    font-weight 650
  .ant-input-number,
  .ant-select
    width 100%
  small
    color var(--text-dark)

.operations-parameter-empty
  padding 14px
  color var(--text-dark)
  border 1px dashed var(--main-darker)
  border-radius 6px

.operations-run-actions
  margin 14px 0
  display flex
  align-items center
  gap 10px
  span
    color var(--text-dark)
    font-size 12px

.operations-no-task
  min-height 180px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 8px
  color var(--text-dark)
  border-top 1px solid var(--main-darker)
  svg
    font-size 26px
    color var(--primary)

.operations-task-panel
  margin-top 14px
  padding-top 14px
  border-top 1px solid var(--main-darker)
  > header
    display flex
    justify-content space-between
    gap 10px
    > div
      min-width 0
      display flex
      flex-direction column
      span
        color var(--text-dark)
        font-size 12px
  > footer
    margin-top 10px
    display flex
    justify-content flex-end

.operations-task-steps
  margin 8px 0
  display flex
  flex-wrap wrap
  gap 6px
  span
    padding 3px 7px
    color var(--text-dark)
    background var(--main-light)
    border 1px solid var(--main-darker)
    border-radius 4px
    &.done
      color #22b573
    &.running
      color var(--primary)

.operations-virtual-log
  height 300px
  overflow auto
  background #0d1117
  border 1px solid #273244
  border-radius 6px
  pre
    box-sizing border-box
    min-width 100%
    min-height 20px
    margin 0
    padding 10px 12px
    color #d8dee9
    font-family Consolas, "Microsoft YaHei UI", monospace
    font-size 12px
    line-height 20px
    white-space pre

.operations-history
  height 100%
  padding 14px
  overflow-y auto

.operations-history-head
  margin-bottom 10px
  display flex
  align-items center
  justify-content space-between
  color var(--text-dark)

.operations-history article
  margin-bottom 7px
  padding 8px 10px
  display flex
  align-items center
  gap 8px
  background var(--main-light)
  border 1px solid var(--main-darker)
  border-radius 6px
  > button
    flex 1
    min-width 0
    display flex
    flex-direction column
    gap 3px
    text-align left
    color var(--text)
    background transparent
    border 0
    cursor pointer
    span,
    small
      color var(--text-dark)

.operations-placeholder
  height 100%
  display flex
  align-items center
  justify-content center

.operations-maintenance
  height 100%
  min-height 0
  padding 0 14px 14px
  display flex
  flex-direction column
  gap 10px

.operations-maintenance-safety
  flex 0 0 auto
  padding 10px 12px
  display flex
  align-items center
  gap 12px
  border 1px solid var(--main-darker)
  border-radius 8px
  background var(--main-light)
  > button
    flex 0 0 auto

.operations-maintenance-guarantees
  flex 1
  min-width 0
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 10px
  > div
    min-width 0
    display flex
    align-items flex-start
    gap 8px
    > svg
      flex 0 0 auto
      margin-top 2px
      color var(--primary)
    > span
      min-width 0
      display flex
      flex-direction column
      gap 2px
      strong
        color var(--text-light)
        font-size 12px
      small
        color var(--text-dark)
        font-size 11px
        line-height 1.4

.operations-maintenance-catalog
  flex 1
  min-height 0
  overflow hidden
  border: 1px solid var(--main-darker)
  border-radius 8px
  .qm-wrap-embedded
    background var(--main-light)

@media (max-width: 900px)
  .operations-toolkit-workspace
    left 8px !important
    right 8px
  .operations-diagnostic
    grid-template-columns minmax(200px, 36%) minmax(0, 1fr)
  .operations-parameter-grid
    grid-template-columns 1fr
  .operations-maintenance-guarantees
    grid-template-columns 1fr
  .operations-maintenance-safety
    align-items flex-end

@media (max-height: 620px)
  .operations-toolkit-workspace
    height calc(100vh - 68px)
    max-height none
    bottom 34px
