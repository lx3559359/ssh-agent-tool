.operations-toolkit-loading
  position absolute
  left 50%
  top 50%
  z-index 90
  transform translate(-50%, -50%)
  color var(--text-dark)

.operations-toolkit-workspace
  box-sizing border-box
  position absolute
  right var(--operations-right-offset, 10px)
  bottom 44px
  z-index 89
  height 680px
  max-height calc(100vh - 88px)
  min-height 360px
  display flex
  flex-direction column
  overflow hidden
  color var(--sp-text)
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  border 1px solid var(--sp-border-strong)
  border-radius var(--sp-radius-panel)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-panel)

.operations-workspace-head
  min-height 48px
  padding 0 14px
  display flex
  align-items center
  justify-content space-between
  border-bottom 1px solid var(--sp-border)
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  box-shadow var(--sp-shadow-control)
  > div
    min-width 0
    display flex
    align-items baseline
    gap 10px
    strong
      font-size 15px
    span
      font-size 12px
      color var(--text-dark)

.operations-workspace-tabs
  margin 10px 14px 0
  flex 0 0 auto

.operations-recommended-flow
  min-height 34px
  margin 8px 14px 0
  display flex
  align-items center
  gap 8px
  overflow-x auto
  padding 8px 10px
  color var(--sp-text-muted)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-toolbar)
  box-shadow var(--sp-shadow-card)
  font-size 12px
  > span
    flex 0 0 auto
    font-weight 650
  > div
    display flex
    align-items center
    gap 2px
    min-width max-content
  .ant-btn
    color var(--text)
    border-radius var(--sp-radius-control)
    box-shadow var(--sp-shadow-sm)
    &:hover,
    &:focus-visible
      color var(--primary)
      background var(--main-light)

.operations-workspace-body
  position relative
  flex 1
  min-height 0
  margin-top 8px
  overflow hidden

.operations-toolkit-compact-pinned
  .operations-workspace-head,
  .operations-workspace-tabs,
  .operations-recommended-flow
    display none
  .operations-workspace-body
    margin-top 0

.operations-toolkit-compact-close
  position absolute
  top 4px
  right 4px
  z-index 4
  width 32px
  height 32px

.operations-discovery-spin
  position absolute
  top 48px
  right 26px
  z-index 2

.operations-diagnostic
  height 100%
  min-height 0
  display grid
  grid-template-columns minmax(230px, 29%) minmax(0, 1fr)
  border-top 1px solid var(--main-darker)

.operations-catalog
  min-width 0
  padding 12px
  display flex
  flex-direction column
  gap 10px
  overflow hidden
  border-right 1px solid var(--main-darker)
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)

.operations-categories
  display flex
  gap 5px
  overflow-x auto
  scrollbar-width thin
  button
    flex 0 0 auto
    padding 4px 8px
    color var(--text-dark)
    background transparent
    border 0
    border-radius var(--sp-radius-small)
    cursor pointer
    &.active
      color var(--primary)
      background var(--main)

.operations-tool-list
  flex 1
  min-height 0
  display grid
  grid-template-columns repeat(auto-fit, minmax(190px, 1fr))
  align-content start
  gap 7px
  overflow-y auto
  > button
    min-width 0
    padding 9px 10px
    display flex
    flex-direction column
    gap 4px
    text-align left
    color var(--sp-text)
    background-color var(--sp-surface-elevated)
    background-image var(--sp-card-background)
    border 1px solid var(--sp-border)
    border-radius var(--sp-radius-card)
    box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
    transition border-color var(--sp-motion-fast) ease, box-shadow var(--sp-motion-fast) ease, background-color var(--sp-motion-fast) ease
    cursor pointer
    &:focus-visible
      outline 2px solid var(--sp-primary)
      outline-offset 2px
      box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-panel)
    &:hover
      border-color var(--sp-primary)
      box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-panel)
    &.active
      border-color var(--sp-primary)
      background-color var(--sp-primary-soft)
      background-image var(--sp-card-background)
      box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card), 0 0 0 2px var(--sp-primary-soft)
    strong
      font-size 13px
    span
      overflow hidden
      color var(--text-dark)
      font-size 12px
      line-height 1.5
      display -webkit-box
      -webkit-line-clamp 2
      -webkit-box-orient vertical
    small
      color var(--text-dark)

.operations-tool-detail
  min-width 0
  padding 16px
  overflow-y auto
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-panel)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-panel)

.operations-tool-title
  display flex
  justify-content space-between
  align-items flex-start
  gap 12px
  h3
    margin 0
    font-size 17px
  p
    margin 5px 0 0
    color var(--text-dark)
    line-height 1.5

.operations-connection-status
  min-height 36px
  margin 14px 0
  padding 6px 10px
  display flex
  align-items center
  gap 7px
  color var(--text-dark)
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  border 1px solid var(--main-darker)
  border-radius var(--sp-radius-toolbar)
  box-shadow var(--sp-shadow-control)
  > span
    width 7px
    height 7px
    border-radius 50%
    background var(--text-dark)
    &.connected
      background #22b573
  button
    margin-left auto

.operations-discovery-error,
.operations-task-error
  margin 8px 0
  padding 8px 10px
  color var(--error)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  border 1px solid var(--error)
  border-radius var(--sp-radius-card)
  box-shadow var(--sp-shadow-card)

.operations-parameter-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 12px

.operations-parameter-field
  min-width 0
  display flex
  flex-direction column
  gap 5px
  > span
    font-size 12px
    font-weight 650
  .ant-input-number,
  .ant-select
    width 100%
  small
    color var(--text-dark)

.operations-parameter-empty
  padding 14px
  color var(--text-dark)
  border 1px dashed var(--main-darker)
  border-radius var(--sp-radius-card)
  box-shadow var(--sp-shadow-md)

.operations-run-actions
  margin 14px 0
  display flex
  align-items center
  gap 10px
  > span
    color var(--text-dark)
    font-size 12px
  .ant-btn-primary
    color #fff !important
    font-weight 600
    text-shadow none
    &:hover,
    &:focus
      color #fff !important
    &:focus-visible
      outline 2px solid var(--primary)
      outline-offset 2px
    &[disabled]
      color rgba(255, 255, 255, .72) !important

.operations-no-task
  min-height 180px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 8px
  color var(--text-dark)
  border-top 1px solid var(--main-darker)
  svg
    font-size 26px
    color var(--primary)

.operations-task-panel
  margin-top 14px
  padding 14px
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
  > header
    display flex
    justify-content space-between
    gap 10px
    > div
      min-width 0
      display flex
      flex-direction column
      span
        color var(--text-dark)
        font-size 12px
  > footer
    margin-top 10px
    display flex
    justify-content flex-end

.operations-task-steps
  margin 8px 0
  display flex
  flex-wrap wrap
  gap 6px
  span
    padding 3px 7px
    color var(--text-dark)
    background var(--main-light)
    border 1px solid var(--main-darker)
    border-radius var(--sp-radius-small)
    box-shadow none
    &.done
      color #22b573
    &.running
      color var(--primary)

.operations-virtual-log
  height 300px
  overflow auto
  background #0d1117
  border 1px solid #273244
  border-radius var(--sp-radius-small)
  pre
    box-sizing border-box
    min-width 100%
    min-height 20px
    margin 0
    padding 10px 12px
    color #d8dee9
    font-family Consolas, "Microsoft YaHei UI", monospace
    font-size 12px
    line-height 20px
    white-space pre

.operations-history
  height 100%
  padding 14px
  overflow-y auto

.operations-history-head
  margin-bottom 10px
  display flex
  align-items center
  justify-content space-between
  color var(--text-dark)

.operations-history article
  margin-bottom 7px
  padding 8px 10px
  display flex
  align-items center
  gap 8px
  background var(--sp-flat-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-small)
  box-shadow none
  &:hover
    background var(--sp-surface-soft)
  > button
    flex 1
    min-width 0
    display flex
    flex-direction column
    gap 3px
    text-align left
    color var(--text)
    background transparent
    border 0
    cursor pointer
    span,
    small
      color var(--text-dark)

.operations-placeholder
  height 100%
  display flex
  align-items center
  justify-content center

.operations-script-steps
  margin-top 14px
  padding 12px
  color var(--text)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  border 1px solid var(--main-darker)
  border-radius var(--sp-radius-card)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
  > strong
    display block
    margin-bottom 8px
    color var(--text-light)
  ol
    margin 0
    padding-left 22px
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 6px 18px
  li
    min-width 0
    line-height 1.5
    color var(--text-dark)

.operations-maintenance
  height 100%
  min-height 0
  padding 0 14px 14px
  display flex
  flex-direction column
  gap 10px

.operations-maintenance-safety
  flex 0 0 auto
  padding 10px 12px
  display flex
  align-items center
  gap 12px
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  box-shadow var(--sp-shadow-card)
  > button
    flex 0 0 auto

.operations-maintenance-guarantees
  flex 1
  min-width 0
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 10px
  > div
    min-width 0
    display flex
    align-items flex-start
    gap 8px
    > svg
      flex 0 0 auto
      margin-top 2px
      color var(--primary)
    > span
      min-width 0
      display flex
      flex-direction column
      gap 2px
      strong
        color var(--text-light)
        font-size 12px
      small
        color var(--text-dark)
        font-size 11px
        line-height 1.4

  .operations-maintenance-contract
    grid-column 1 / -1
    align-items center
    flex-wrap wrap
    padding-top 8px
    border-top 1px solid var(--sp-border)
    > span
      display block
      color var(--text-dark)
      font-size 11px
      line-height 1.5

.operations-toolkit-workspace .qm-list-wrap
  grid-template-columns repeat(auto-fit, minmax(230px, 1fr))

.operations-maintenance-catalog
  flex 1
  min-height 0
  overflow hidden
  border: 1px solid var(--main-darker)
  border-radius var(--sp-radius-panel)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-panel)
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  .qm-wrap-embedded
    background var(--sp-flat-background)

@media (max-width: 900px)
  .operations-toolkit-workspace
    left 72px !important
    right 8px
  .operations-diagnostic
    grid-template-columns minmax(200px, 36%) minmax(0, 1fr)
  .operations-parameter-grid
    grid-template-columns 1fr
  .operations-maintenance-guarantees
    grid-template-columns 1fr
  .operations-maintenance-safety
    align-items flex-end
  .operations-script-steps ol
    grid-template-columns 1fr

@media (max-width: 680px)
  .operations-toolkit-workspace
    left 8px !important
    z-index 210
  .operations-diagnostic
    display flex
    flex-direction column
    overflow-y auto
  .operations-catalog
    flex 0 0 auto
    max-height 310px
    overflow visible
    border-right 0
    border-bottom 1px solid var(--main-darker)
  .operations-tool-list
    max-height 210px
    grid-template-columns 1fr
  .operations-tool-detail
    flex 0 0 auto
    overflow visible
  .operations-maintenance-safety
    align-items stretch
    flex-direction column
  .operations-toolkit-workspace .qm-list-wrap
    grid-template-columns 1fr

@media (max-height: 620px)
  .operations-toolkit-workspace
    height calc(100vh - 68px)
    max-height none
    min-height 0
    bottom 34px
  .operations-workspace-body
    min-height 0
    overflow-y auto
    overscroll-behavior contain
