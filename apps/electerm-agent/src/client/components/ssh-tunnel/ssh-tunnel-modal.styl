.ssh-tunnel-modal
  .ant-modal-content
    padding 0
    overflow hidden
    background-color var(--sp-surface-elevated)
    background-image var(--sp-overlay-background)
    border-radius var(--sp-radius-overlay)
    box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)

  .ant-btn,
  .ant-input,
  .ant-input-affix-wrapper,
  .ant-input-number,
  .ant-select-selector,
  textarea
    border-radius var(--sp-radius-control) !important
    box-shadow var(--sp-shadow-sm)

  .ant-modal-header
    padding 18px 22px
    margin 0
    background-color var(--sp-surface)
    background-image var(--sp-control-background)
    border-bottom 1px solid var(--border-color, rgba(127, 127, 127, .2))

  .ant-modal-body
    padding 0

.ssh-tunnel-modal-title
  display inline-flex
  align-items center
  gap 8px

.ssh-tunnel-scroll
  max-height calc(100vh - 150px)
  overflow-y auto
  padding 18px 22px 22px

.ssh-tunnel-context
  display flex
  align-items center
  justify-content space-between
  gap 16px
  padding 12px 14px
  margin-bottom 16px
  border 1px solid var(--border-color, rgba(127, 127, 127, .25))
  border-radius var(--sp-radius-toolbar)
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  box-shadow var(--sp-shadow-control)

  > div
    min-width 0

  strong,
  span
    display block

  span
    margin-top 3px
    opacity .7
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

.ssh-tunnel-layout
  display grid
  grid-template-columns minmax(0, 1.08fr) minmax(320px, .92fr)
  gap 16px

.ssh-tunnel-editor,
.ssh-tunnel-runtime
  min-width 0
  padding 16px
  border 1px solid var(--border-color, rgba(127, 127, 127, .25))
  border-radius var(--sp-radius-panel)
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-lg)

.ssh-tunnel-section-title
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px
  margin-bottom 14px

  strong,
  span
    display block

  span
    margin-top 3px
    opacity .68

.ssh-tunnel-type-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 8px

.ssh-tunnel-type-card
  min-width 0
  min-height 84px
  padding 12px
  text-align left
  color inherit
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  border 1px solid var(--border-color, rgba(127, 127, 127, .28))
  border-radius var(--sp-radius-card)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
  cursor pointer

  strong,
  span
    display block

  span
    margin-top 6px
    opacity .66
    line-height 1.5

  &:hover,
  &.active
    border-color #1677ff
    background rgba(22, 119, 255, .08)

.ssh-tunnel-template-row
  display flex
  align-items center
  gap 12px
  margin 14px 0

  > span
    flex none
    opacity .72

  .ant-select
    flex 1

.ssh-tunnel-form-grid
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 12px

.ssh-tunnel-field
  display flex
  min-width 0
  flex-direction column
  gap 6px

  .ant-input-number
    width 100%

  small
    min-height 34px
    line-height 1.5
    opacity .62

.ssh-tunnel-field-label
  font-weight 600

.ssh-tunnel-flow
  padding 12px
  margin-top 14px
  border-left 3px solid #1677ff
  border-radius var(--sp-radius-card)
  background rgba(22, 119, 255, .07)
  box-shadow var(--sp-shadow-md)

  span,
  strong
    display block

  span
    margin-bottom 5px
    opacity .66

  strong
    overflow-wrap anywhere

.ssh-tunnel-editor-actions
  display flex
  justify-content flex-end
  gap 8px
  margin-top 14px

.ssh-tunnel-port-conflict
  margin-top 14px

  .ant-alert-action
    align-self center

.ssh-tunnel-running-list
  display grid
  gap 10px
  margin-top 12px

.ssh-tunnel-saved-section
  padding-bottom 16px
  margin-bottom 16px
  border-bottom 1px solid var(--border-color, rgba(127, 127, 127, .2))

.ssh-tunnel-saved-list
  display grid
  gap 8px

.ssh-tunnel-saved-card
  display flex
  align-items flex-start
  justify-content space-between
  gap 10px
  padding 11px
  border 1px solid var(--border-color, rgba(127, 127, 127, .25))
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)

  &.active
    border-color #1677ff
    background rgba(22, 119, 255, .07)

  > div
    min-width 0

  strong,
  span
    display block

  span
    margin 5px 0 8px
    line-height 1.45
    opacity .72
    overflow-wrap anywhere

.ssh-tunnel-runtime-section
  min-width 0

.ssh-tunnel-running-card
  padding 13px
  border 1px solid var(--border-color, rgba(127, 127, 127, .25))
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)

  header
    display flex
    align-items center
    justify-content space-between
    gap 8px

    > div
      display flex
      min-width 0
      align-items center
      gap 8px

  p
    margin 10px 0
    line-height 1.55
    opacity .76
    overflow-wrap anywhere

.ssh-tunnel-test-result
  display flex
  align-items center
  gap 6px
  padding 7px 9px
  margin-bottom 10px
  border-radius var(--sp-radius-small)
  box-shadow none
  background rgba(82, 196, 26, .1)
  color #52c41a

  &.failed
    color #ff4d4f
    background rgba(255, 77, 79, .1)

.ssh-tunnel-history-list
  display grid
  gap 8px
  max-height 420px
  overflow-y auto
  padding-right 4px

.ssh-tunnel-history-item
  display grid
  gap 6px
  padding 10px
  border 1px solid var(--border-color, rgba(127, 127, 127, .24))
  border-radius var(--sp-radius-small)
  background var(--sp-flat-background)
  box-shadow none

  > div
    display flex
    align-items center
    justify-content space-between
    gap 8px

  span,
  code
    opacity .7

  strong,
  code
    overflow-wrap anywhere

.ssh-tunnel-runtime-card
  display grid
  gap 12px
  padding 16px

.ssh-tunnel-runtime-card-header
  display flex
  align-items flex-start
  justify-content space-between
  gap 12px

  > div
    min-width 0

  strong,
  span
    display block

  > div > span
    margin-top 4px
    line-height 1.45
    opacity .7
    overflow-wrap anywhere

.ssh-tunnel-availability
  flex none
  margin-inline-end 0

  &--passed
    color #067647
    background rgba(18, 183, 106, .12)
    border-color rgba(18, 183, 106, .3)

  &--limited
    color #b54708
    background rgba(247, 144, 9, .12)
    border-color rgba(247, 144, 9, .32)

  &--failed
    color #b42318
    background rgba(240, 68, 56, .11)
    border-color rgba(240, 68, 56, .3)

  &--unverified,
  &--checking
    color inherit
    background rgba(127, 127, 127, .1)
    border-color var(--border-color, rgba(127, 127, 127, .25))

.ssh-tunnel-access-panel
  min-width 0
  padding 14px
  background rgba(22, 119, 255, .07)
  border 1px solid rgba(22, 119, 255, .24)
  border-radius var(--sp-radius-card)

  > span,
  > strong,
  > code
    display block

  > span
    font-size 12px
    font-weight 600
    opacity .72

  > strong
    margin-top 6px
    font-size 17px
    overflow-wrap anywhere

  > code
    margin-top 5px
    overflow-wrap anywhere

  > p
    margin 8px 0
    line-height 1.55
    opacity .76

  &--invalid
    background rgba(127, 127, 127, .07)
    border-color var(--border-color, rgba(127, 127, 127, .24))

  &--remote
    background rgba(247, 144, 9, .08)
    border-color rgba(247, 144, 9, .28)

.ssh-tunnel-access-fields
  display flex
  flex-wrap wrap
  gap 12px 22px
  margin 10px 0

  div
    display flex
    align-items baseline
    gap 6px

  dt
    opacity .68

  dd
    margin 0

.ssh-tunnel-stage-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 8px

.ssh-tunnel-stage
  min-width 0
  padding 10px
  border 1px solid transparent
  border-radius var(--sp-radius-small)

  > span:last-child
    display block
    margin-top 6px
    font-size 12px
    line-height 1.45
    overflow-wrap anywhere

.ssh-tunnel-stage-status
  display flex
  align-items center
  gap 6px

  strong
    font-size 13px

.ssh-tunnel-stage--passed
  color #067647
  background rgba(18, 183, 106, .1)
  border-color rgba(18, 183, 106, .24)

.ssh-tunnel-stage--limited
  color #b54708
  background rgba(247, 144, 9, .1)
  border-color rgba(247, 144, 9, .28)

.ssh-tunnel-stage--failed
  color #b42318
  background rgba(240, 68, 56, .09)
  border-color rgba(240, 68, 56, .25)

.ssh-tunnel-stage--unverified
  color inherit
  background rgba(127, 127, 127, .08)
  border-color var(--border-color, rgba(127, 127, 127, .2))

.ssh-tunnel-stage-empty
  margin 0
  padding 10px
  border-radius var(--sp-radius-small)
  background rgba(127, 127, 127, .07)
  opacity .7

.ssh-tunnel-diagnostic
  min-width 0
  padding 14px
  border 1px solid rgba(240, 68, 56, .25)
  border-radius var(--sp-radius-card)
  background rgba(240, 68, 56, .07)

  > span,
  > strong
    display block

  > span
    font-size 12px
    font-weight 600
    opacity .72

  > strong
    margin-top 5px
    font-size 16px

  > p,
  > ol
    line-height 1.55

  > ol
    padding-left 20px

  &--warning
    border-color rgba(247, 144, 9, .3)
    background rgba(247, 144, 9, .08)

.ssh-tunnel-diagnostic-split
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 10px
  margin 12px 0

.ssh-tunnel-diagnostic-checks,
.ssh-tunnel-diagnostic-config
  min-width 0
  padding 10px
  border 1px solid var(--border-color, rgba(127, 127, 127, .22))
  border-radius var(--sp-radius-small)
  background var(--sp-flat-background)

  header
    display flex
    align-items center
    justify-content space-between
    gap 8px

  pre
    max-width 100%
    margin 8px 0 0
    white-space pre-wrap
    overflow-wrap anywhere

  code
    overflow-wrap anywhere

.ssh-tunnel-diagnostic-code
  display block
  margin-top 10px
  font-size 12px
  opacity .68
  overflow-wrap anywhere

.ssh-tunnel-runtime-card-actions
  display flex
  flex-wrap wrap
  gap 8px

.ssh-tunnel-guide-modal
  .ant-modal-content
    overflow hidden
    background-color var(--sp-surface-elevated)
    border-radius var(--sp-radius-overlay)
    box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)

  .ant-modal-body
    min-width 0

.ssh-tunnel-guide-layout
  display grid
  grid-template-columns 220px minmax(0, 1fr)
  gap 18px
  min-width 0
  max-height calc(100vh - 180px)

.ssh-tunnel-guide-nav
  display flex
  min-width 0
  flex-direction column
  gap 5px
  padding 8px
  border 1px solid var(--border-color, rgba(127, 127, 127, .24))
  border-radius var(--sp-radius-card)
  background var(--sp-flat-background)
  overflow-y auto

  button
    width 100%
    padding 9px 10px
    text-align left
    color inherit
    background transparent
    border 1px solid transparent
    border-radius var(--sp-radius-small)
    cursor pointer
    overflow-wrap anywhere

    &:hover,
    &.active
      color #1677ff
      background rgba(22, 119, 255, .08)
      border-color rgba(22, 119, 255, .22)

.ssh-tunnel-guide-content
  min-width 0
  overflow-y auto
  padding-right 4px

.ssh-tunnel-guide-section
  min-width 0

  h3
    margin 6px 0 14px

  p,
  li,
  dd
    line-height 1.65

  code
    overflow-wrap anywhere

.ssh-tunnel-guide-kicker
  font-size 12px
  font-weight 600
  color #1677ff

.ssh-tunnel-guide-flow
  display block
  padding 12px
  margin 8px 0 14px
  white-space normal
  border-radius var(--sp-radius-small)
  background rgba(127, 127, 127, .08)
  overflow-wrap anywhere

.ssh-tunnel-guide-scenarios,
.ssh-tunnel-guide-topic-grid
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 10px

  article
    min-width 0
    padding 12px
    border 1px solid var(--border-color, rgba(127, 127, 127, .24))
    border-radius var(--sp-radius-card)
    background var(--sp-flat-background)

  p
    margin 6px 0 0

.ssh-tunnel-guide-scenarios article:first-child
  background rgba(22, 119, 255, .07)
  border-color rgba(22, 119, 255, .28)

.ssh-tunnel-guide-callout
  min-width 0
  padding 12px
  margin-bottom 10px
  border 1px solid var(--border-color, rgba(127, 127, 127, .24))
  border-radius var(--sp-radius-card)
  background var(--sp-flat-background)

  p
    margin 5px 0

  &--safe
    background rgba(18, 183, 106, .08)
    border-color rgba(18, 183, 106, .26)

  &--warning
    background rgba(247, 144, 9, .08)
    border-color rgba(247, 144, 9, .28)

.ssh-tunnel-guide-error-list,
.ssh-tunnel-guide-glossary
  display grid
  gap 10px

  > div
    min-width 0
    padding 11px
    border 1px solid var(--border-color, rgba(127, 127, 127, .22))
    border-radius var(--sp-radius-small)
    background var(--sp-flat-background)

  dt
    font-weight 600

  dd
    margin 5px 0 0
    opacity .76

.ssh-tunnel-guide-context,
.ssh-tunnel-guide-context-code
  display block
  margin-top 14px
  overflow-wrap anywhere

@media (max-width: 1100px)
  .ssh-tunnel-layout
    grid-template-columns 1fr

  .ssh-tunnel-type-grid
    grid-template-columns 1fr

  .ssh-tunnel-form-grid
    grid-template-columns 1fr

@media (max-width: 760px)
  .ssh-tunnel-stage-grid,
  .ssh-tunnel-diagnostic-split,
  .ssh-tunnel-guide-layout,
  .ssh-tunnel-guide-scenarios,
  .ssh-tunnel-guide-topic-grid
    grid-template-columns 1fr

  .ssh-tunnel-guide-layout
    max-height none

  .ssh-tunnel-guide-nav,
  .ssh-tunnel-guide-content
    max-width 100%
    overflow-x hidden

  .ssh-tunnel-runtime-card-header
    flex-direction column
