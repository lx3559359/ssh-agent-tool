
.add-menu-wrap
  position fixed
  z-index 1000
  background-color var(--sp-surface-elevated)
  background-image var(--sp-overlay-background)
  border 1px solid var(--sp-border-strong)
  border-radius var(--sp-radius-overlay)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)
  min-width 300px
  max-width 600px
  overflow hidden
  margin-top 4px
  padding 4px 15px
  display flex
  flex-direction column
  .drag-handle
    right 3px
    display block
  .add-menu-header
    flex-shrink 0
  .add-menu-list
    flex 1
    overflow hidden
    display flex
    flex-direction column
    min-height 0
    .sidebar-panel-history
      position relative
      top auto
      left auto
      right auto
      bottom auto
      flex 1
      min-height 0

