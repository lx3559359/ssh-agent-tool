.quick-connect-form
  width 100%
  max-width 360px
  padding 12px
  box-sizing border-box

.quick-connect-form-title
  display flex
  align-items center
  gap 8px
  margin-bottom 10px
  color var(--text)
  font-weight 650

.quick-connect-protocol
  width 92px

.quick-connect-port
  width 82px

.quick-connect-wizard
  .ant-modal-body
    padding-top 18px
  .ant-btn:disabled,
  .ant-btn.ant-btn-disabled
    color var(--sp-text-disabled)
    background var(--sp-surface)
    border-color var(--sp-border)
    opacity 1

.quick-connect-wizard-body
  min-height 238px
  padding 16px 0 8px
  > p
    margin 0 0 10px
    color var(--text-dark)
    font-size 13px

.quick-connect-endpoint-fields
  display grid
  grid-template-columns 110px minmax(0, 1fr) 96px
  gap 10px
  align-items end

.quick-connect-field
  min-width 0
  margin-bottom 10px
  > label
    display flex
    gap 5px
    margin-bottom 4px
    color var(--sp-text)
    font-size 12px
    font-weight 600
    > span
      color var(--sp-text-muted)
      font-weight 400
  .ant-select,
  .ant-input,
  .ant-input-affix-wrapper
    width 100%

.quick-connect-save-field
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 2px 8px
  align-items center
  margin-bottom 10px
  > label
    color var(--sp-text)
    font-weight 600
    > span
      color var(--sp-text-muted)
      font-weight 400
  > p
    grid-column 1 / -1
    margin 0
    color var(--sp-text-muted)
    font-size 12px

.quick-connect-wizard-summary
  padding 14px
  display flex
  flex-direction column
  gap 5px
  color var(--text)
  background var(--main-light)
  border 1px solid var(--main-darker)
  border-radius 6px
  > span
    color var(--text-dark)
    font-size 12px

.quick-connect-wizard-advanced
  margin-top 16px
  border-top 1px solid var(--main-darker)
  .ant-collapse-header
    padding-left 0 !important
    padding-right 0 !important

.quick-connect-group-field
  margin-top 8px

.quick-connect-group-field > label
  display block
  margin-bottom 6px
  color var(--sp-text)
  font-weight 600
  > span
    color var(--sp-text-muted)
    font-weight 400
  .ant-collapse-content-box
    padding-left 0 !important
    padding-right 0 !important

.quick-connect-wizard-footer
  display flex
  align-items center
  justify-content space-between
  padding-top 14px
  border-top 1px solid var(--main-darker)

@media (max-width: 700px)
  .quick-connect-wizard
    max-width calc(100vw - 24px)
  .quick-connect-group-field
    width 100%
  .quick-connect-endpoint-fields
    grid-template-columns 1fr

@media (max-height: 560px)
  .quick-connect-wizard
    top 8px
    padding-bottom 8px
    .ant-modal-content
      max-height calc(100vh - 16px)
      display flex
      flex-direction column
      overflow hidden
    .ant-modal-body
      min-height 0
      overflow-y auto
    .quick-connect-wizard-body
      min-height 180px
      padding-top 12px
