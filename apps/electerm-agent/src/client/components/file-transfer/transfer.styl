.transports-wrap
  position absolute
  left 60px
  top 3px
  right 60px
  height 36px

.transports-circle-wrap
  text-align center
  position relative
  z-index 10
.transports-dd
  position absolute
  left 0
  right 0
  overflow-y scroll
  z-index 11
  background-color var(--sp-surface)
  background-image var(--sp-panel-background)
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-panel)
  box-shadow var(--sp-shadow-lg)

.transports-wrap
  .transports-dd
    display none
  &:hover .transports-dd
    display block

.transports-title
  border-bottom 1px solid var(--primary)
  padding 10px 15px
.transports-content
  max-height 200px
  padding 10px 0
.sftp-transport
  display flex
  align-items center
  padding 8px 5px
  border-bottom 1px solid var(--sp-border)
  background var(--sp-flat-background)
  box-shadow none
  &:hover
    font-weight bold
  .transfer-control-icon
    padding-right 5px
    padding-left 5px
    margin-top -2px
    &:hover
      color var(--primary-contrast)
      background var(--primary)
      border-radius 20px
  .transfer-progress-block
    flex 1 1 260px
    min-width 180px
    max-width 420px
    gap 2px
  .transfer-progress-meta
    color var(--text-light)
    font-size 11px
    font-weight normal
    line-height 16px
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
  .ant-progress
    line-height 1
    margin 0
  .ant-progress-inner
    background var(--border)

.flex-child + .flex-child
  margin-left 5px
  flex-grow 1
.transfer-control-icon
  margin-right 3px
  margin-top 3px
