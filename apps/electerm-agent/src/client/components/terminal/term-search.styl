
.term-search-opt-icon
  margin 0 3px
  color var(--text-light)
  font-size 15px
  &:hover
    color var(--text)
  &.term-search-on
    background #333
    color #aaa
.term-search-wrap
  position absolute
  top 100px
  right 5px
  z-index 200
  background-color var(--sp-surface-elevated)
  background-image var(--sp-overlay-background)
  border 1px solid var(--sp-border-strong)
  border-radius var(--sp-radius-overlay)
  box-shadow var(--sp-shadow-overlay)
