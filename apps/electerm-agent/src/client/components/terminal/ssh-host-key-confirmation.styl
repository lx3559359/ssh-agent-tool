.ssh-host-key-confirmation,
.ssh-host-key-confirmation-instructions
  min-width 0
  color var(--text)
  line-height 1.5

.ssh-host-key-confirmation
  padding 12px
  border 1px solid var(--main-lighter)
  border-radius var(--sp-radius-card)
  background var(--sp-flat-background)

  &.is-changed
    border-color var(--error)

  dl
    display grid
    grid-template-columns max-content minmax(0, 1fr)
    gap 10px 14px
    margin 0

  dt
    color var(--text-light)
    font-weight 600

  dd
    min-width 0
    margin 0

  code
    min-width 0
    font-family var(--font-family-mono, Consolas, monospace)
    overflow-wrap anywhere
    white-space normal
    word-break break-word

.ssh-host-key-warning
  margin -2px 0 12px
  padding 9px 10px
  color var(--error)
  background unquote('color-mix(in srgb, var(--error) 10%, transparent)')
  border-left 3px solid var(--error)
  border-radius var(--sp-radius-control)

.ssh-host-key-copy-row
  display flex
  align-items flex-start
  gap 8px

  code
    flex 1 1 auto

  button
    flex 0 0 auto
    min-height 30px

.terminal-interactive-confirm-actions
  display flex
  justify-content flex-end
  gap 8px

@media (max-width: 560px)
  .ssh-host-key-confirmation dl
    grid-template-columns minmax(0, 1fr)
    gap 4px

  .ssh-host-key-confirmation dt:not(:first-child)
    margin-top 6px

  .ssh-host-key-copy-row
    flex-direction column
