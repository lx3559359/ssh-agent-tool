
.drag-handle
  position absolute
  right 0
  top 0
  width 3px
  bottom 0
  // cursor ew-resize
  display none
  z-index 201
  overflow hidden
  &.dragging
    background var(--sp-primary)
  &:focus-visible
    outline 2px solid var(--sp-primary)
    outline-offset -2px
    box-shadow var(--sp-shadow-focus)
