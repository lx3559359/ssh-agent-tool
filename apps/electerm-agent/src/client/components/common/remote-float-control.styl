.remote-float-control
  position fixed
  top 10px
  right 10px
  z-index 9999

.remote-float-control-inline
  display inline-block
  position relative

.remote-float-btn-inline
  display inline
  cursor pointer

.remote-float-btn
  padding 8px
  background-color var(--sp-surface)
  background-image var(--sp-control-background)
  border 1px solid var(--sp-border-strong)
  border-radius var(--sp-radius-control)
  box-shadow var(--sp-shadow-control)
  color var(--sp-text)
  cursor pointer
  opacity 0.8
  transition opacity 0.3s
  display flex
  align-items center
  justify-content center
  &:hover
  &.ant-dropdown-open
    opacity 1
  &:focus-visible
    outline 2px solid var(--sp-primary)
    outline-offset 2px
    box-shadow var(--sp-shadow-focus)

@media (prefers-reduced-motion: reduce)
  .remote-float-btn
    transition none
