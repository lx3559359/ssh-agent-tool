.custom-drawer
  position fixed
  top 0
  left 72px
  right 0
  bottom 0

.custom-drawer-mask
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  background rgba(0, 0, 0, 0.45)

.custom-drawer-content-wrapper
  position absolute
  top 0
  bottom 0
  box-sizing border-box
  background-color var(--sp-surface-elevated)
  background-image var(--sp-overlay-background)
  border 1px solid var(--sp-border-strong)
  border-radius var(--sp-radius-overlay)
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-overlay)
  overflow auto
  color var(--text)

.custom-drawer-left .custom-drawer-content-wrapper
  left 0
  border-radius 0 var(--sp-radius-overlay) var(--sp-radius-overlay) 0

.custom-drawer-right .custom-drawer-content-wrapper
  right 0
  border-radius var(--sp-radius-overlay) 0 0 var(--sp-radius-overlay)

.custom-drawer-content
  position relative
  height 100%
  width 100%

.custom-drawer-title
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0
