.lazy-module-error
  position relative
  z-index 1200
  display flex
  align-items center
  gap 10px
  min-width 260px
  max-width 520px
  margin 12px auto
  padding 12px
  border 1px solid var(--sp-border)
  border-radius var(--sp-radius-card)
  background-color var(--sp-surface-elevated)
  background-image var(--sp-card-background)
  color inherit
  box-shadow inset 0 1px 0 var(--sp-highlight), var(--sp-shadow-card)
.lazy-module-error-icon
  flex 0 0 auto
  color var(--sp-warn)
.lazy-module-error-copy
  display flex
  flex 1 1 auto
  min-width 0
  flex-direction column
  gap 2px
  strong
    font-size 13px
  span
    font-size 12px
    line-height 1.5
    white-space normal
