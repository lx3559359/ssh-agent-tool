.markdown-wrap
  color var(--sp-text)
  line-height 1.65
  overflow-wrap anywhere

  h1,
  h2,
  h3,
  h4
    margin 14px 0 7px
    color var(--sp-text)
    line-height 1.4

  h1
    font-size 18px

  h2
    font-size 16px

  h3,
  h4
    font-size 14px

  p
    margin 7px 0

  ul,
  ol
    margin 7px 0
    padding-left 22px

  li
    margin 4px 0

  a
    color var(--sp-primary)

  code
    padding 1px 4px
    border-radius var(--sp-radius-small)
    color var(--sp-text)
    background var(--sp-flat-background)
    box-shadow none

  pre
    padding 10px
    overflow auto
    border 1px solid var(--sp-border)
    border-radius var(--sp-radius-small)
    background var(--sp-flat-background)
    box-shadow none

    code
      padding 0
      background transparent
      box-shadow none

  table
    width 100%
    border-collapse collapse
    table-layout fixed
    background var(--sp-flat-background)
    box-shadow none

  th,
  td
    padding 6px 8px
    border 1px solid var(--sp-border)
    text-align left
    overflow-wrap anywhere

  blockquote
    margin 8px 0
    padding-left 10px
    border-left 3px solid var(--sp-primary)
    color var(--sp-text-muted)

  > :first-child
    margin-top 0

  > :last-child
    margin-bottom 0
